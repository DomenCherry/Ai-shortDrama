{
  "name": "ai-short-drama",
  "private": true,
  "version": "0.1.0",
  "description": "AI short drama creation workspace",
  "scripts": {
    "setup:api": "python3.11 -m venv .venv && .venv/bin/pip install -r apps/api/requirements.txt",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": ".venv/bin/uvicorn app.main:app --app-dir apps/api --host 127.0.0.1 --port 8000",
    "db:migrate": ".venv/bin/alembic -c apps/api/alembic.ini upgrade head",
    "lint:web": "npm --prefix apps/web run lint",
    "typecheck:web": "npm --prefix apps/web run typecheck"
  },
  "engines": {
    "node": ">=20"
  }
}
